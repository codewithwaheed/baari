# ============================================================
# Baari — Environment Variables
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_URL=http://localhost:3001
WEB_URL=http://localhost:3000
# Production: https://app.baari.pk and https://api.baari.pk

# ── Database ─────────────────────────────────────────────────
# Self-hosted on DO Droplet for MVP. Set to DO Managed Postgres URL in production.
DATABASE_URL=postgres://baari:baari_dev@localhost:5432/baari
# Superuser URL used by db:migrate to bootstrap the baari database.
# Docker default (baari is a superuser): postgres://baari:baari_dev@localhost:5432/postgres
# Homebrew postgres (macOS): postgres://YOUR_SYSTEM_USER@localhost:5432/postgres
ADMIN_DATABASE_URL=postgres://baari:baari_dev@localhost:5432/postgres
# DB pool settings
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000

# ── Redis / Valkey ───────────────────────────────────────────
# Local Redis on Droplet for MVP. Set to DO Managed Valkey URL in production.
# Note: DO discontinued Managed Redis June 2025. Use Managed Caching for Valkey.
REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://default:password@valkey-cluster.db.ondigitalocean.com:25061

# ── Auth (JWT) ───────────────────────────────────────────────
# Must be at least 32 characters. Generate: openssl rand -base64 32
JWT_SECRET=replace_with_32_char_minimum_secret_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── WhatsApp (Meta Cloud API via 360dialog) ──────────────────
# Get from Meta Developer App settings
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
# Set this to any string you choose — used to verify webhook setup
META_VERIFY_TOKEN=your_chosen_verify_token
# 360dialog partner settings (for Embedded Signup)
DIALOG_API_KEY=your_360dialog_api_key
DIALOG_PARTNER_ID=your_360dialog_partner_id

# ── Payments ─────────────────────────────────────────────────
# RECOMMENDED: Start with Safepay (licensed PSP aggregator)
# No SBP license required. Covers JazzCash + EasyPaisa + Raast + Card in one.
SAFEPAY_API_KEY=your_safepay_api_key
SAFEPAY_API_SECRET=your_safepay_api_secret
SAFEPAY_WEBHOOK_SECRET=your_safepay_webhook_secret
SAFEPAY_ENV=sandbox  # sandbox | production

# PayFast (alternative aggregator — better Raast coverage)
# PAYFAST_MERCHANT_ID=your_payfast_merchant_id
# PAYFAST_MERCHANT_KEY=your_payfast_merchant_key

# JazzCash (direct integration — add after Safepay is stable)
# Required for sub-merchant provisioning (negotiate with JazzCash enterprise team)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_ENV=sandbox  # sandbox | production
# Sandbox: https://sandbox.jazzcash.com.pk
# Production: https://payments.jazzcash.com.pk

# EasyPaisa (direct integration — add after JazzCash is stable)
# Requires NTN and bank docs. Contact: devops@easypaisa.com.pk
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ENV=sandbox  # sandbox | production

# ── Storage (DO Spaces = S3-compatible) ──────────────────────
SPACES_KEY=your_do_spaces_key
SPACES_SECRET=your_do_spaces_secret
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_BUCKET=baari-media
SPACES_CDN_URL=https://baari-media.sgp1.cdn.digitaloceanspaces.com

# ── Monitoring ───────────────────────────────────────────────
SENTRY_DSN=
# Sentry Free tier: 5K errors/mo — sufficient for MVP
